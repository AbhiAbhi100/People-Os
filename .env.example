# --- Database ---
# Production: a Postgres connection string (Neon, Supabase, Render Postgres...).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Without it, PeopleOS keeps data in an embedded Postgres under data/pglite (fine for local use).
# PUBLIC_URL=https://your-app.onrender.com   (used in invite links; defaults to the request host)

# --- AI model ---
# PeopleOS works with NO key (rule-based agents). Add ONE provider for free-form questions.

# --- Option A: Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-5-5

# --- Option B: any OpenAI-compatible API (OpenAI, Groq free tier, OpenRouter, Ollama local) ---
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#   Ollama (fully local): OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  LLM_MODEL=qwen2.5:7b

# --- Option C: Google Gemini ---
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-3.8-flash
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite   (used automatically when the main model is overloaded)

# Force a provider (anthropic | openai | gemini | offline)
# LLM_PROVIDER=offline
PORT=3000

# Structured output method for OpenAI-compatible servers (auto: functionCalling when OPENAI_BASE_URL is set)
# STRUCTURED_METHOD=functionCalling

# Optional: LangSmith tracing of every LangChain/LangGraph run (free tier available)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=peopleos
