{
  "name": "peopleos",
  "version": "1.0.0",
  "description": "Multi-agent HR copilot: LangGraph orchestrator, LangChain models + RAG, human-in-the-loop approvals, talk-to-data, MCP server. Node.js.",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --no-warnings src/db/seed.js",
    "mcp": "node --no-warnings --env-file-if-exists=.env src/mcp/server.js",
    "eval": "node --no-warnings --env-file-if-exists=.env evals/run.js",
    "graph": "node --no-warnings scripts/graph.js",
    "test:llm": "node --no-warnings evals/llm-smoke.js"
  },
  "author": "AbhiAbhi100",
  "license": "MIT",
  "dependencies": {
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/openai": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chart.js": "^4.5.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13 <25"
  },
  "keywords": [
    "langgraph",
    "langchain",
    "agents",
    "mcp",
    "rag",
    "text-to-sql",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AbhiAbhi100/People-Os"
  }
}
